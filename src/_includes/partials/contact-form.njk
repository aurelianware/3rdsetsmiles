{# contact-form.njk — Reusable appointment request form #}
{% set fid = formId or 'contact' %}
<form class="contact-form" id="{{ fid }}" method="POST" action="/contact-submit" novalidate>
  <h3>Request an Appointment</h3>
  <p class="form-intro">Tell us a little about what you're looking for and we'll get back to you within one business day.</p>
  <p class="form-intro" style="font-size:0.9rem"><strong>Please don't include medical history or health details.</strong> This form is for scheduling only and isn't a secure channel for medical information.</p>

  <div class="form-grid">
    <div class="form-group">
      <label for="{{ fid }}-name">Your Name <span aria-hidden="true">*</span></label>
      <input id="{{ fid }}-name" name="name" type="text" required autocomplete="name">
    </div>
    <div class="form-group">
      <label for="{{ fid }}-phone">Phone Number <span aria-hidden="true">*</span></label>
      <input id="{{ fid }}-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel">
    </div>
    <div class="form-group">
      <label for="{{ fid }}-email">Email Address</label>
      <input id="{{ fid }}-email" name="email" type="email" autocomplete="email">
    </div>
    <div class="form-group">
      <label for="{{ fid }}-reason">How can we help?</label>
      <select id="{{ fid }}-reason" name="reason">
        <option>New patient exam &amp; cleaning</option>
        <option>Dental implants consultation</option>
        <option>All-on-4 / Full-arch consultation</option>
        <option>Cosmetic dentistry (veneers, whitening)</option>
        <option>Clear aligners</option>
        <option>Crowns, bridges, or fillings</option>
        <option>Emergency / pain</option>
        <option>Insurance question</option>
        <option>Other</option>
      </select>
    </div>
  </div>
  <div class="form-group">
    <label for="{{ fid }}-message">Message <span class="optional">(optional)</span></label>
    <textarea id="{{ fid }}-message" name="message" rows="3" placeholder="Briefly describe what you need."></textarea>
  </div>

  {# Honeypot for spam bots — real users won't fill this #}
  <div class="form-honeypot" aria-hidden="true">
    <label>Leave this field empty <input type="text" name="company" tabindex="-1" autocomplete="off"></label>
  </div>

  {# Marketing attribution — populated client-side by analytics.js (UTM +
     attribution_id). No PHI; ties the request to its acquisition source. #}
  <input type="hidden" name="attribution_id" data-attribution>
  <input type="hidden" name="utm_source" data-attribution>
  <input type="hidden" name="utm_medium" data-attribution>
  <input type="hidden" name="utm_campaign" data-attribution>
  <input type="hidden" name="utm_content" data-attribution>
  <input type="hidden" name="utm_term" data-attribution>
  <input type="hidden" name="landing_page" data-attribution>
  <input type="hidden" name="referrer" data-attribution>

  <button class="btn-primary form-submit" type="submit">Request Appointment</button>
  <p class="form-note">
    {# Submissions POST to the Cloudflare Pages Function at /functions/contact-submit.js.
       Delivery requires RESEND_API_KEY, CONTACT_TO_EMAIL, and CONTACT_FROM_EMAIL to be
       set in the Pages dashboard; until then the handler asks visitors to call/email. #}
    Prefer to talk now? Call <a href="tel:{{ site.phone.telShort }}" data-action="call-contact">{{ site.phone.display }}</a>
    or email <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
  </p>
</form>
