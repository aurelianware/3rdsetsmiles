{# nav.njk — Shared site nav. Items come from /src/_data/nav.js #}
{% from "partials/booking-cta.njk" import bookingCta %}
<a class="skip-link" href="#main">Skip to main content</a>
<header class="nav" id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="{{ site.name }} home">
      <span class="nav-logo-text">3<sup>RD</sup> SET SMILES</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {% for item in nav.primary %}
        <a href="{{ item.url }}"
           class="nav-link{% if page.url == item.url or (item.url != '/' and page.url.startsWith(item.url)) %} active{% endif %}">
          {{ item.label }}
        </a>
      {% endfor %}
      {{ bookingCta(booking, "Book Online", { class: "nav-book", source: "header" }) }}
      <a href="tel:{{ site.phone.telShort }}" class="nav-phone" data-action="call-header">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        {{ site.phone.display }}
      </a>
    </nav>

    <button class="nav-mobile-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
      <svg id="menu-icon" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg id="close-icon" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:none" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <nav class="nav-mobile-menu" id="mobile-menu" aria-label="Mobile">
    {% for item in nav.primary %}
      <a href="{{ item.url }}">{{ item.label }}</a>
    {% endfor %}
    {{ bookingCta(booking, "Book Online", { class: "nav-mobile-book", source: "mobile_nav" }) }}
    <a href="tel:{{ site.phone.telShort }}" class="nav-mobile-call" data-action="call-header">Call {{ site.phone.display }}</a>
  </nav>
</header>
