{# ============================================================================
   base.njk — Single source of truth for <head>, nav, footer, JSON-LD.
   Every page extends this layout. Phone, address, hours come from
   /src/_data/site.json. NEVER hardcode NAP details in a page template.
   ============================================================================ #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="{{ site.themeColor }}">

  {# Per-page title / description / canonical.
     `localizeTitle` (set once for the whole services/ folder via its directory
     data file) appends the city/region to the <title> for local-search intent,
     e.g. "Dental Implants in Tempe, AZ | 3rd Set Smiles" — without touching the
     visible H1, breadcrumb, or FAQ heading, which keep the clean service name. #}
  <title>{{ title }}{% if localizeTitle %} in {{ site.address.locality }}, {{ site.address.region }}{% endif %} | {{ site.name }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ page.url | absUrl(site.domain) }}">

  {% if noindex %}
  <meta name="robots" content="noindex, follow">
  {% endif %}

  {# Open Graph #}
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }} | {{ site.name }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ page.url | absUrl(site.domain) }}">
  <meta property="og:image" content="{{ (ogImage or site.ogImage) | absUrl(site.domain) }}">
  <meta property="og:locale" content="en_US">

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} | {{ site.name }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ (ogImage or site.ogImage) | absUrl(site.domain) }}">

  {# Fonts — loaded non-render-blocking to protect mobile LCP. The print/onload
     swap is CSP-safe here (script-src allows 'unsafe-inline'); the <noscript>
     fallback keeps fonts working without JS. #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- set fontsHref = "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Source+Sans+3:wght@300;400;600;700&display=swap" %}
  <link rel="preload" as="style" href="{{ fontsHref }}">
  <link rel="stylesheet" href="{{ fontsHref }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ fontsHref }}"></noscript>

  {# Favicons #}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/assets/favicon-16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">

  {# Site CSS #}
  <link rel="stylesheet" href="/assets/css/main.css">

  {# JSON-LD below. Every `| dump` value is also piped through `| safe`:
     Nunjucks HTML-escapes by default, which would turn the quotes produced
     by `| dump` into &quot; and make the JSON unparsable (Google:
     "Unparsable structured data"). `| dump` already JSON-encodes each string
     safely, so `| safe` only prevents the redundant HTML escaping. #}
  {# Centralized Dentist JSON-LD — identical on every page #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Dentist",
    "@id": {{ (site.domain + "/#dentist") | dump | safe }},
    "name": {{ site.name | dump | safe }},
    "url": {{ site.domain | dump | safe }},
    "telephone": {{ site.phone.tel | dump | safe }},
    "email": {{ site.email | dump | safe }},
    "priceRange": "$$",
    "founder": {
      "@type": "Person",
      "name": {{ site.dentist.name | dump | safe }},
      "jobTitle": {{ site.dentist.credential | dump | safe }}
    },
    "areaServed": [
      {%- for area in site.areaServed %}
      {{ area | dump | safe }}{% if not loop.last %},{% endif %}
      {%- endfor %}
    ],
    "hasMap": {{ ("https://www.google.com/maps?q=" + site.geo.lat + "," + site.geo.lng) | dump | safe }},
    "image": {{ (site.ogImage | absUrl(site.domain)) | dump | safe }},
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ site.address.street | dump | safe }},
      "addressLocality": {{ site.address.locality | dump | safe }},
      "addressRegion": {{ site.address.region | dump | safe }},
      "postalCode": {{ site.address.postalCode | dump | safe }},
      "addressCountry": {{ site.address.country | dump | safe }}
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ site.geo.lat }},
      "longitude": {{ site.geo.lng }}
    },
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "10:00",
      "closes": "18:00"
    }],
    "sameAs": [
      {{ site.social.google | dump | safe }},
      {{ site.social.yelp | dump | safe }},
      {{ site.social.facebook | dump | safe }}
    ],
    "potentialAction": {
      "@type": "ReserveAction",
      "name": "Book a dental appointment",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": {{ (site.domain + "/book/") | dump | safe }},
        "actionPlatform": [
          "http://schema.org/DesktopWebPlatform",
          "http://schema.org/MobileWebPlatform"
        ]
      },
      "result": {
        "@type": "Reservation",
        "name": "Dental appointment"
      }
    }
  }
  </script>

  {# Per-page FAQPage JSON-LD #}
  {% if faq %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for item in faq %}
      {
        "@type": "Question",
        "name": {{ item.q | dump | safe }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ item.a | dump | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  {# BreadcrumbList JSON-LD #}
  {% if breadcrumb %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {% for crumb in breadcrumb %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "name": {{ crumb.label | dump | safe }},
        "item": {{ (crumb.url | absUrl(site.domain)) | dump | safe }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  {# Analytics: intentionally omitted. The previous Plausible script token was
     not provisioned for this domain (404), so the include and its CSP entries
     were removed. Re-add a verified analytics snippet here when one is set up. #}
</head>
<body class="page-{{ page.fileSlug or 'home' }}">

  {% include "partials/nav.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {# Sticky tap-to-call bar — mobile only. High-intent local dental searches are
     mobile-heavy and mobile converts best, so keep the phone one tap away. #}
  <a class="mobile-call-bar" href="tel:{{ site.phone.tel }}" data-action="call-sticky"
     aria-label="Call {{ site.name }} at {{ site.phone.display }}">
    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
    <span>Call {{ site.phone.display }}</span>
  </a>

  <script src="/assets/js/main.js" defer></script>
</body>
</html>
