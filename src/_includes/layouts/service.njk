---
layout: layouts/base.njk
---
<section class="page-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <a href="/services/">Services</a>
      <span class="sep">›</span>
      {{ title }}
    </div>
    {% set cat = serviceCategories | findCategory(serviceMeta.category) %}
    <div class="pill"><span class="pill-text">{{ cat.label if cat else serviceMeta.category }}</span></div>
    <h1>{{ heroHeadline | safe }}</h1>
    <p class="lede">{{ heroSub }}</p>
    <div class="btn-row">
      {% if callFirst %}
      <a href="tel:{{ site.phone.tel }}" class="btn-primary" data-action="call-hero">Call {{ site.phone.display }}</a>
      <a href="/contact/" class="btn-outline">Request an Appointment</a>
      {% else %}
      <a href="/contact/" class="btn-primary">Request an Appointment</a>
      <a href="tel:{{ site.phone.telShort }}" class="btn-outline" data-action="call-service">Call {{ site.phone.display }}</a>
      {% endif %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container-narrow prose fade-in">
    {{ content | safe }}
  </div>
</section>

{% if faq %}
<section class="section section-cream">
  <div class="container-narrow">
    <div class="fade-in">
      <div class="section-label">Common Questions</div>
      <h2 style="color:var(--navy);margin-bottom:24px">{{ title }} FAQ</h2>
    </div>
    <div class="faq-block">
      {% for item in faq %}
      <div class="faq-item fade-in">
        <button class="faq-btn" type="button" aria-expanded="false">
          <span>{{ item.q }}</span>
          <svg class="faq-chevron" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>{{ item.a }}</p></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# Per-service structured data. Ties each procedure to the practice's central
   Dentist node (@id from base.njk) so search engines connect service → provider.
   Every `| dump` value is also piped through `| safe` for the same reason as the
   JSON-LD in base.njk: `| dump` already JSON-encodes, and `| safe` prevents
   Nunjucks from HTML-escaping the quotes into unparsable structured data. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": {{ title | dump | safe }},
  "url": {{ (page.url | absUrl(site.domain)) | dump | safe }},
  "description": {{ description | dump | safe }},
  "provider": {
    "@type": "Dentist",
    "@id": {{ (site.domain + "/#dentist") | dump | safe }},
    "name": {{ site.name | dump | safe }}
  },
  "areaServed": [
    {%- for area in site.areaServed %}
    {{ area | dump | safe }}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>

<section class="section cta-banner">
  <div class="container">
    <div class="fade-in">
      <h2>Ready to talk to Dr. Phillips?</h2>
      <p>Schedule a consultation at our Tempe office. We'll listen, examine, and give you honest options &mdash; no pressure.</p>
      <div class="btn-row">
        <a href="/contact/" class="btn-primary">Request an Appointment</a>
        <a href="tel:{{ site.phone.telShort }}" class="btn-outline" data-action="call-service">Call {{ site.phone.display }}</a>
      </div>
    </div>
  </div>
</section>
