---
layout: layouts/base.njk
title: "Book an Appointment Online"
description: "Book your dental appointment at 3rd Set Smiles in Tempe, AZ. Pick a preferred date and time online and we'll confirm within one business day. Or call (480) 334-2752."
permalink: /book/
breadcrumb:
  - { label: "Home", url: "/" }
  - { label: "Book Online", url: "/book/" }
---

<section class="page-hero">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a><span class="sep">›</span>Book Online</div>
    <h1>Book an <span>Appointment</span></h1>
    <p class="lede">Pick a preferred date and time and we'll confirm within one business day. Prefer to talk? Call <a href="tel:{{ site.phone.telShort }}" style="color:var(--gold)" data-action="call-book">{{ site.phone.display }}</a>.</p>
  </div>
</section>

<section class="section contact-section">
  <div class="container">
    <div class="contact-wrap">

      <div class="contact-info">
        <div class="fade-in">
          <h2>Online Booking</h2>
          <p>Choose the day and time that work best for you. Because Dr. Phillips runs a single-doctor practice, every request is reviewed by our team — we'll reach out to confirm your exact appointment time.</p>
        </div>
        <div class="fade-in">
          <div class="contact-detail">
            <div class="contact-detail-label">Office Hours</div>
            <div class="contact-detail-value">{{ site.hours.display }}<br>{{ site.hours.weekend }}</div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-label">Phone</div>
            <div class="contact-detail-value"><a href="tel:{{ site.phone.telShort }}" data-action="call-book">{{ site.phone.display }}</a></div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-label">Location</div>
            <div class="contact-detail-value">{{ site.address.full }}</div>
          </div>
        </div>
        <div class="fade-in" style="margin-top:24px">
          <p style="color:rgba(255,255,255,0.6);font-size:0.92rem">Not ready to pick a time? You can <a href="/contact/" style="color:var(--gold-light)">send a general appointment request</a> instead.</p>
        </div>
      </div>

      <div class="contact-form-wrap fade-in">
        <form class="contact-form" id="book" method="POST" action="/book-appointment" novalidate>
          <h3>Request Your Appointment</h3>
          <p class="form-intro">Tell us who you are and when you'd like to come in. We'll confirm the exact time by phone or email.</p>
          <p class="form-intro" style="font-size:0.9rem"><strong>Please don't include medical history or health details.</strong> This form is for scheduling only and isn't a secure channel for medical information.</p>

          <fieldset class="form-group">
            <legend>Have you visited 3rd Set Smiles before? <span aria-hidden="true">*</span></legend>
            <label><input name="patientRelationship" type="radio" value="Existing" required> Yes, I'm an existing patient</label>
            <label><input name="patientRelationship" type="radio" value="New" required> No, I'm a new patient</label>
          </fieldset>
          <div class="form-group">
            <label for="book-reason">Appointment type <span aria-hidden="true">*</span></label>
            <select id="book-reason" name="reason" required disabled>
              <option value="">First choose new or existing patient</option>
            </select>
          </div>
          <div class="form-group">
            <label for="book-provider">Provider</label>
            <select id="book-provider" disabled><option value="">Available provider</option></select>
          </div>
          <div class="form-group">
            <label for="book-location">Location</label>
            <select id="book-location" disabled><option value="">Practice location</option></select>
          </div>
          <div class="form-group">
            <label for="book-date">Available date <span aria-hidden="true">*</span></label>
            <select id="book-date" required disabled><option value="">Choose an appointment type first</option></select>
          </div>
          <div class="form-group">
            <label for="book-time">Available time <span aria-hidden="true">*</span></label>
            <select id="book-time" required disabled><option value="">Choose a date first</option></select>
            <p id="book-availability-status" class="form-note" role="status" aria-live="polite">Choose whether you are a new or existing patient to load current availability.</p>
          </div>
          <input type="hidden" name="preferredStart" id="book-preferred-start">
          <input type="hidden" name="availabilityToken" id="book-availability-token">

          <div class="form-group">
            <label for="book-name">Your Name <span aria-hidden="true">*</span></label>
            <input id="book-name" name="name" type="text" required autocomplete="name">
          </div>
          <div class="form-group">
            <label for="book-phone">Phone Number <span aria-hidden="true">*</span></label>
            <input id="book-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel">
          </div>
          <div class="form-group">
            <label for="book-email">Email Address</label>
            <input id="book-email" name="email" type="email" autocomplete="email">
          </div>
          <div class="form-group">
            <label for="book-preferredContact">Best way to reach you</label>
            <select id="book-preferredContact" name="preferredContact">
              <option value="">No preference</option><option value="Phone">Phone call</option><option value="Text">Text message</option><option value="Email">Email</option>
            </select>
          </div>
          <fieldset class="form-group">
            <legend>Will you be using dental insurance? <span class="optional">(optional)</span></legend>
            <label><input name="insuranceIntent" type="radio" value="Yes"> Yes</label>
            <label><input name="insuranceIntent" type="radio" value="No"> No</label>
            <label><input name="insuranceIntent" type="radio" value="Not sure"> Not sure</label>
          </fieldset>
          <div class="form-group" id="book-carrier-group" hidden>
            <label for="book-insuranceCarrier">Insurance carrier <span class="optional">(optional)</span></label>
            <input id="book-insuranceCarrier" name="insuranceCarrier" type="text" autocomplete="off" placeholder="e.g. Delta Dental, Cigna, MetLife">
            <p class="form-note" style="margin-top:6px">Just the plan name for now — please don't enter member or subscriber ID numbers here. We'll verify your specific benefits before your visit.</p>
          </div>

          <div class="form-group">
            <label for="book-message">Anything else? <span class="optional">(optional)</span></label>
            <textarea id="book-message" name="message" rows="3" placeholder="A good time to reach you, a second choice of day, etc."></textarea>
          </div>

          {# Honeypot for spam bots — real users won't fill this #}
          <div class="form-honeypot" aria-hidden="true">
            <label>Leave this field empty <input type="text" name="company" tabindex="-1" autocomplete="off"></label>
          </div>

          {# Marketing attribution — populated client-side by analytics.js from
             the visitor's session (UTM + attribution_id). No PHI; lets staff/
             CloudDentalOffice tie a request to its acquisition source. #}
          <input type="hidden" name="attribution_id" data-attribution>
          <input type="hidden" name="utm_source" data-attribution>
          <input type="hidden" name="utm_medium" data-attribution>
          <input type="hidden" name="utm_campaign" data-attribution>
          <input type="hidden" name="utm_content" data-attribution>
          <input type="hidden" name="utm_term" data-attribution>
          <input type="hidden" name="landing_page" data-attribution>
          <input type="hidden" name="referrer" data-attribution>
          {# One ID per logical form submission. It is retained in the posted
             body across browser/network retries and becomes CDO's
             Idempotency-Key. The server supplies a UUID for legacy/no-JS use. #}
          <input type="hidden" name="requestId" id="book-request-id">

          <button class="btn-primary form-submit" type="submit">Request Appointment</button>
          <p class="form-note">
            {# Submissions POST to the Cloudflare Pages Function at /functions/book-appointment.js,
               which creates a staff-reviewable request in Cloud Dental Office when CLOUDDENTAL_API_BASE is
               configured, and otherwise emails the request (or asks the visitor to call). #}
            We're closed weekends. Prefer to talk now? Call <a href="tel:{{ site.phone.telShort }}" data-action="call-book">{{ site.phone.display }}</a>
            or email <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
          </p>
        </form>
      </div>

    </div>
  </div>
</section>

<script src="/assets/js/booking.js" defer></script>
<script>
  (function () {
    var requestId = document.getElementById("book-request-id");
    if (requestId && !requestId.value && window.crypto && window.crypto.randomUUID) {
      requestId.value = window.crypto.randomUUID();
    }

    // Reveal the carrier field only when the visitor says they'll use insurance.
    // Also disable + clear it when hidden so its value is never submitted on
    // opt-out (a hidden-but-enabled input still POSTs). Sync on init and on
    // bfcache restore so a restored radio selection stays consistent.
    var carrier = document.getElementById("book-carrier-group");
    var carrierInput = document.getElementById("book-insuranceCarrier");
    if (carrier && carrierInput) {
      var syncCarrier = function () {
        var checked = document.querySelector('input[name="insuranceIntent"]:checked');
        var useInsurance = !!checked && checked.value === "Yes";
        carrier.hidden = !useInsurance;
        carrierInput.disabled = !useInsurance;
        if (!useInsurance) carrierInput.value = "";
      };
      document.querySelectorAll('input[name="insuranceIntent"]').forEach(function (r) {
        r.addEventListener("change", syncCarrier);
      });
      syncCarrier();
      window.addEventListener("pageshow", syncCarrier);
    }
  })();
</script>
