---
layout: layouts/base.njk
title: "Page Not Found"
description: "The page you're looking for doesn't exist. Try our home page or call 3rd Set Smiles at (480) 334-2752."
permalink: /404.html
noindex: true
eleventyExcludeFromCollections: true
---

<section class="error-wrap">
  <div>
    <h1>404</h1>
    <p style="font-size:1.4rem;color:var(--navy);margin-bottom:14px">Page not found.</p>
    <p>The page you're looking for has moved, doesn't exist, or never did. From here you can:</p>
    <div class="btn-row" style="justify-content:center;margin-top:20px">
      <a href="/" class="btn-primary">Go to the home page</a>
      <a href="/services/" class="btn-outline btn-outline-dark">See our services</a>
      <a href="tel:{{ site.phone.telShort }}" class="btn-outline btn-outline-dark" data-action="call-404">Call {{ site.phone.display }}</a>
    </div>
  </div>
</section>

{# Report the missing URL to analytics so 404s are diagnosable in GA4. Cloudflare
   serves this page AT the requested (bad) path, so window.location.pathname is
   the offending URL — track() records it as the event's `path`. analytics.js is
   deferred, so it has defined window.track by the time DOMContentLoaded fires. #}
<script>
  window.addEventListener('DOMContentLoaded', function () {
    if (window.track && window.ANALYTICS_EVENTS) {
      window.track(window.ANALYTICS_EVENTS.PAGE_NOT_FOUND);
    }
  });
</script>
