---
layout: layouts/base.njk
title: "Contact & Appointments"
description: "Contact 3rd Set Smiles in Tempe, AZ. Call (480) 334-2752 or request an appointment online. 2600 E Southern Ave, Suite B1, Tempe, AZ 85282."
permalink: /contact/
breadcrumb:
  - { label: "Home", url: "/" }
  - { label: "Contact", url: "/contact/" }
---
{% from "partials/booking-cta.njk" import bookingCta %}

<section class="page-hero">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a><span class="sep">›</span>Contact</div>
    <h1>Contact <span>3rd Set Smiles</span></h1>
    <p class="lede">Call, email, or send a quick appointment request. We respond within one business day.</p>
  </div>
</section>

<section class="section contact-section">
  <div class="container">
    <div class="contact-wrap">

      <div class="contact-info">
        <div class="fade-in">
          <h2>Get in Touch</h2>
          <p>We're a private, single-doctor practice. The team that answers the phone is the team that will see you when you arrive.</p>
        </div>
        <div class="fade-in">
          <div class="contact-detail">
            <div class="contact-detail-label">Phone</div>
            <div class="contact-detail-value"><a href="tel:{{ site.phone.telShort }}" data-action="call-contact">{{ site.phone.display }}</a></div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-label">Email</div>
            <div class="contact-detail-value"><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-label">Address</div>
            <div class="contact-detail-value">
              {{ site.address.street }}<br>
              {{ site.address.locality }}, {{ site.address.region }} {{ site.address.postalCode }}
            </div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-label">Hours</div>
            <div class="contact-detail-value">
              {{ site.hours.display }}<br>
              <span class="muted" style="color:rgba(255,255,255,0.55)">{{ site.hours.weekend }}</span>
              {% if site.hours.note %}<br><span class="muted" style="color:rgba(255,255,255,0.55)">{{ site.hours.note }}</span>{% endif %}
            </div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-label">Social</div>
            <div class="contact-detail-value">
              <a href="{{ site.social.google }}" rel="noopener">Google</a> &middot;
              <a href="{{ site.social.yelp }}" rel="noopener">Yelp</a> &middot;
              <a href="{{ site.social.facebook }}" rel="noopener">Facebook</a>
            </div>
          </div>
        </div>

        <div class="fade-in btn-row" style="margin-top:24px">
          {{ bookingCta(booking, "Book Online", { source: "contact", aria: "Book online with " + booking.bookingProviderName + " on Zocdoc" }) }}
          <a class="btn-outline" href="https://www.google.com/maps/dir/?api=1&destination=2600+E+Southern+Ave+Suite+B1+Tempe+AZ+85282" rel="noopener" data-action="directions">Get Directions</a>
        </div>

        <figure class="contact-photo fade-in">
          <img src="/assets/office/office-exterior.webp" alt="Entrance to 3rd Set Smiles in Tempe, Arizona — look for the DENTIST sign" loading="lazy" width="990" height="864">
          <figcaption>Look for the <strong>DENTIST</strong> sign — we&rsquo;re right inside the gate.</figcaption>
        </figure>
      </div>

      <div class="contact-form-wrap fade-in">
        {% include "partials/contact-form.njk" %}
      </div>

    </div>
  </div>
</section>

{# Google Map to the practice. Keyless embed (output=embed) built from the NAP
   in site.json — never hardcode the address here. Requires the Google Maps
   hosts in the CSP frame-src (see src/_headers). Lazy-loaded to protect LCP.
   To swap in Google's official "Share → Embed a map" iframe, replace the src
   with its https://www.google.com/maps/embed?pb=… URL (same CSP applies). #}
<section class="section" style="padding-top:0" aria-label="Map to our Tempe office">
  <div class="container">
    <iframe
      class="contact-map"
      src="https://www.google.com/maps?q={{ (site.name + ', ' + site.address.full) | urlencode }}&z=15&output=embed"
      title="Map to {{ site.name }} at {{ site.address.full }}"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</section>
