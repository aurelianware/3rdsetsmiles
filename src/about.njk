{# Canonical Person entity for Dr. Phillips. Shares one @id (…/#dr-phillips)
   with the founder node in base.njk and the author ProfilePage, so search
   engines resolve them to a single provider. worksFor links him to the
   practice's Dentist node (…/#dentist). Only verified, non-CONFIRM facts are
   marked up here — no unconfirmed awards, dates, or memberships.
   alumniOf lists NYU College of Dentistry, his only degree (DDS 2004, confirmed
   by Mark 2026-09-30). His in-progress W. P. Carey (ASU) MBA is intentionally
   not listed; add it to the page and alumniOf/hasCredential once conferred.
   sameAs lists his public profile pages from src/_data/authors.js (Zocdoc
   provider profile; not the booking link). #}
{% set drp = authors['dr-matthew-phillips'] %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": (site.domain + "/#dr-phillips"),
  "name": drp.name,
  "honorificSuffix": drp.credential,
  "jobTitle": drp.role,
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "degree",
    "name": "Doctor of Dental Surgery (DDS), 2004",
    "recognizedBy": { "@type": "CollegeOrUniversity", "name": "New York University College of Dentistry" }
  },
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "New York University College of Dentistry",
    "sameAs": "https://dental.nyu.edu/"
  },
  "description": drp.profileSummary,
  "url": (site.domain + "/about/"),
  "sameAs": drp.sameAs,
  "mainEntityOfPage": (page.url | absUrl(site.domain)),
  "image": (drp.image | absUrl(site.domain)),
  "worksFor": {
    "@type": "Dentist",
    "@id": (site.domain + "/#dentist"),
    "name": site.name
  },
  "knowsAbout": [
    "Dental implants",
    "All-on-4 full-arch implants",
    "Implant-supported dentures",
    "Cosmetic dentistry",
    "General and family dentistry"
  ],
  "areaServed": site.areaServed,
  "potentialAction": {
    "@type": "ReserveAction",
    "name": ("Book an appointment with " + drp.name),
    "target": booking.primaryProviderBookingUrl
  }
} | jsonStringify | safe }}
</script>
